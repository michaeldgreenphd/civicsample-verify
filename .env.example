# Run npm run setup to create separate random local role passwords.
VERIFY_INVESTIGATOR_PASSWORD=
VERIFY_REVIEWER_A_PASSWORD=
VERIFY_REVIEWER_B_PASSWORD=
VERIFY_ADJUDICATOR_PASSWORD=
VERIFY_STAGING_REVIEWER_1_PASSWORD=
VERIFY_STAGING_REVIEWER_2_PASSWORD=
VERIFY_DB_DIR=.local/pglite
# Legacy local pilots may retain VERIFY_DEMO_PASSWORD until role passwords are configured.
# This build is synthetic-only; no production/Supabase credentials are needed.
# Never add a service-role key to the web application. Privileged Supabase administration reads a
# private JSON file OUTSIDE every repository (scripts/supabase-admin.mjs, VERIFY_SUPABASE_ADMIN_CONFIG).
# Optional, design v5 training view: absolute path to the PRIVATE worked_examples_v5.json (never inside this repository).
VERIFY_TLV5_WORKED_EXAMPLES_PATH=
# Supabase deployment mode (set by scripts/supabase-web.mjs from a PRIVATE file; never commit values):
# VERIFY_DATA_BACKEND=supabase
# VERIFY_SUPABASE_URL=https://<project-ref>.supabase.co
# VERIFY_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   (publishable key only; a secret key is refused)
# VERIFY_SUPABASE_ACCOUNT_DOMAIN_REF=<project-ref>
# VERIFY_SITE_ORIGIN=http://127.0.0.1:3300
