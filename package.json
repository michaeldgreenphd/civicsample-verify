{
  "name": "civicsample-verify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/check-build-traces.mjs",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --keepAliveTimeout 70000",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts docs *.md *.json",
    "format:check": "prettier --check src tests scripts docs *.md *.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:fixtures && npm run check:leakage:v4 && npm run check:leakage:v5 && npm run check:leakage:v7",
    "test:analysis": "MU7_ALLOW_NO_DB_BUNDLE=1 MU8_ALLOW_NO_DB_BUNDLE=1 python3 -m pytest -q analysis && VERIFY_ANALYSIS_PYTHON=${VERIFY_ANALYSIS_PYTHON:-python3} node --import tsx --test tests/mu7-analysis.test.ts tests/mu8-roundtrip.test.ts",
    "prepare": "git config core.hooksPath .githooks",
    "test:handoff": "node scripts/test-handoff.mjs",
    "test:postgres": "node --import tsx --test tests/postgres-native.test.ts",
    "test:e2e:production": "VERIFY_E2E_PRODUCTION=1 playwright test",
    "test:handoff:postgres": "node scripts/test-handoff-postgres.mjs",
    "staging:accounts": "node scripts/staging-accounts.mjs",
    "staging:preflight": "node --import tsx scripts/staging-import.ts",
    "check:leakage:v4": "python3 tools/check_public_repo_leakage_v4.py --tree",
    "test:supabase:staging": "node scripts/test-supabase-staging.mjs",
    "supabase:admin": "node scripts/supabase-admin.mjs",
    "supabase:web": "node scripts/supabase-web.mjs",
    "test:supabase:live": "node --import tsx --test tests/staging-live.test.ts",
    "mapconf:import-plan": "node --import tsx scripts/mapconf-import-plan.mjs",
    "check:leakage:v5": "python3 tools/check_public_repo_leakage_v5.py --tree",
    "check:leakage:v7": "python3 tools/check_public_repo_leakage_v7.py --tree",
    "test:handoff:v7:mutation": "node scripts/test-handoff-v7-mutation.mjs",
    "generate:tlv5-pilot": "node scripts/generate-tlv5-pilot-cases.mjs",
    "tlv5:staging-dryrun": "node --import tsx scripts/tlv5-staging-dryrun.ts",
    "demo:mapconf": "node scripts/mapconf-demo.mjs",
    "build:hosted": "node scripts/hosted-build.mjs",
    "start:hosted": "node scripts/hosted-start.mjs",
    "mu81:offline-import-check": "node --import tsx scripts/mu81-disposable-import.ts",
    "mu81:prepare-intake": "node --import tsx scripts/prepare-formal-intake.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
